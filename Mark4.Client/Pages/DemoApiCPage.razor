@page "/User/Analytics/DemoApiCPage"
@using Mark4.Client.Services
@using Microsoft.AspNetCore.Authorization
@using System.Collections.Generic;
@using static Mark4.Client.Services.FeedApiService;

@inject IFeedApiService FeedApiService

@attribute [Authorize]

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@* @rendermode InteractiveAuto *@
@* @rendermode InteractiveWebAssembly *@

<PageTitle>Demo API</PageTitle>
<h3>Demo API</h3>

<button @onclick="GetFeedTable" class="btn btn-primary">Get Data</button>
<button @onclick="Refresh" class="btn btn-primary">Refresh</button>
<hr />

@if (feedApiTable is null)
{
	<div class="row">
		<div class="form-floating mb-3">
			<InputText @bind-Value="instrumentName" class="form-control" placeholder="MSFT" />
		</div>
		<div class="form-floating mb-3">
			<InputText @bind-Value="intervalNum" class="form-control" placeholder="MONTHLY" />
		</div>
	</div>

	<p style="margin: 0; line-height: 1.5;"> Name: msft, ibm, reliance.bse</p>
	<p style="margin: 0; line-height: 1.5;"> Interval: monthly, weekly, daily</p>
	<a href="https://www.alphavantage.co/documentation" style="margin: 0; line-height: 1.5;">credits: alphavantage</a>

}
else
{
	<p style="margin: 0; line-height: 1.5;"> @feedApiTable.MetaData.Symbol</p>
	<p style="margin: 0; line-height: 1.5;"> @feedApiTable.MetaData.Information</p>

	<div class="table-container">
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Date</th>
					<th>Open</th>
					<th>High</th>
					<th>Low</th>
					<th>Close</th>
					<th>Volume</th>
				</tr>
			</thead>
			<tbody>
				@if (String.Compare(intervalNum, "DAILY", comparisonType: StringComparison.OrdinalIgnoreCase) == 0
						|| instrumentName.Contains("BSE", comparisonType: StringComparison.OrdinalIgnoreCase) == true)
				{
					@foreach (KeyValuePair<string, TimeSeriesEntry> TimeSeries in feedApiTable.TimeSeriesDaily)
					{
						<tr class="table-primary">
							<td>@TimeSeries.Key</td>
							<td>@TimeSeries.Value.Open</td>
							<td>@TimeSeries.Value.High</td>
							<td>@TimeSeries.Value.Low</td>
							<td>@TimeSeries.Value.Close</td>
							<td>@TimeSeries.Value.Volume</td>
						</tr>
					}
				}
				else if (String.Compare(intervalNum, "MONTHLY", comparisonType: StringComparison.OrdinalIgnoreCase) == 0)
				{
					@foreach (KeyValuePair<string, TimeSeriesEntry> TimeSeries in feedApiTable.TimeSeriesMonthly)
					{
						<tr class="table-primary">
							<td>@TimeSeries.Key</td>
							<td>@TimeSeries.Value.Open</td>
							<td>@TimeSeries.Value.High</td>
							<td>@TimeSeries.Value.Low</td>
							<td>@TimeSeries.Value.Close</td>
							<td>@TimeSeries.Value.Volume</td>
						</tr>
					}
				}
				else if (String.Compare(intervalNum, "WEEKLY", comparisonType: StringComparison.OrdinalIgnoreCase) == 0)
				{
					@foreach (KeyValuePair<string, TimeSeriesEntry> TimeSeries in feedApiTable.TimeSeriesWeekly)
					{
						<tr class="table-primary">
							<td>@TimeSeries.Key</td>
							<td>@TimeSeries.Value.Open</td>
							<td>@TimeSeries.Value.High</td>
							<td>@TimeSeries.Value.Low</td>
							<td>@TimeSeries.Value.Close</td>
							<td>@TimeSeries.Value.Volume</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}




@code {
	private FeedApiTable? feedApiTable;
	private string instrumentName = "RELIANCE.BSE";
	private string intervalNum = "DAILY"; //TIME_SERIES_MONTHLY TIME_SERIES_WEEKLY TIME_SERIES_DAILY

	private async Task GetFeedTable()
	{
		feedApiTable = await FeedApiService.GetFeedTablesApi(instrumentName.ToUpper(), "TIME_SERIES_" + intervalNum.ToUpper());
	}

	private void Refresh()
	{
		feedApiTable = null;
		instrumentName = "";
	}
}




